<?xml version="1.0" encoding="UTF-8"?>

<wsdl:definitions
    name="PatientService"
    targetNamespace="http://example.com/vet/patients"
    xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
    xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:tns="http://example.com/vet/patients">

    <wsdl:documentation>
        Validation errors are returned as SOAP Fault with fault code
        CLIENT_ERROR and HTTP status 400. Internal server errors are returned
        as SOAP Fault with fault code SERVER_ERROR and HTTP status 500.
        The SOAP faultcode value and the serviceFault/faultCode value must match.
    </wsdl:documentation>

    <wsdl:types>
        <xs:schema
            targetNamespace="http://example.com/vet/patients"
            elementFormDefault="qualified"
            xmlns:tns="http://example.com/vet/patients">

            <xs:simpleType name="AnimalType">
                <xs:restriction base="xs:string">
                    <xs:enumeration value="DOG"/>
                    <xs:enumeration value="CAT"/>
                    <xs:enumeration value="BIRD"/>
                    <xs:enumeration value="REPTILE"/>
                </xs:restriction>
            </xs:simpleType>

            <xs:simpleType name="OwnerNameType">
                <xs:restriction base="xs:string">
                    <xs:minLength value="3"/>
                    <xs:maxLength value="100"/>
                </xs:restriction>
            </xs:simpleType>

            <xs:simpleType name="PetNameType">
                <xs:restriction base="xs:string">
                    <xs:minLength value="1"/>
                    <xs:maxLength value="50"/>
                </xs:restriction>
            </xs:simpleType>

            <xs:simpleType name="PassportNumberType">
                <xs:restriction base="xs:string">
                    <xs:pattern value="[A-Z]{2}-[0-9]{6}"/>
                </xs:restriction>
            </xs:simpleType>

            <xs:simpleType name="UuidType">
                <xs:restriction base="xs:string">
                    <xs:pattern value="[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}"/>
                </xs:restriction>
            </xs:simpleType>

            <xs:simpleType name="FaultCodeType">
                <xs:restriction base="xs:string">
                    <xs:enumeration value="CLIENT_ERROR"/>
                    <xs:enumeration value="SERVER_ERROR"/>
                </xs:restriction>
            </xs:simpleType>

            <xs:complexType name="PatientRegistrationType">
                <xs:sequence>
                    <xs:element name="ownerName" type="tns:OwnerNameType"/>
                    <xs:element name="petName" type="tns:PetNameType"/>
                    <xs:element name="animalType" type="tns:AnimalType"/>
                    <xs:element
                        name="passportNumber"
                        type="tns:PassportNumberType"
                        minOccurs="0"/>
                </xs:sequence>
            </xs:complexType>

            <xs:complexType name="Patient">
                <xs:sequence>
                    <xs:element name="id" type="tns:UuidType"/>
                    <xs:element name="ownerName" type="tns:OwnerNameType"/>
                    <xs:element name="petName" type="tns:PetNameType"/>
                    <xs:element name="animalType" type="tns:AnimalType"/>
                    <xs:element
                        name="passportNumber"
                        type="tns:PassportNumberType"
                        minOccurs="0"/>
                </xs:sequence>
            </xs:complexType>

            <xs:element name="getPatientsRequest">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element
                            name="animalType"
                            type="tns:AnimalType"
                            minOccurs="0"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>

            <xs:element name="getPatientsResponse">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="patients">
                            <xs:complexType>
                                <xs:sequence>
                                    <xs:element
                                        name="patient"
                                        type="tns:Patient"
                                        minOccurs="0"
                                        maxOccurs="unbounded"/>
                                </xs:sequence>
                            </xs:complexType>
                        </xs:element>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>

            <xs:element name="registerPatientRequest">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element
                            name="patient"
                            type="tns:PatientRegistrationType"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>

            <xs:element name="registerPatientResponse">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element
                            name="registeredPatient"
                            type="tns:Patient"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>

            <xs:element name="serviceFault">
                <xs:annotation>
                    <xs:documentation>
                        CLIENT_ERROR is used for validation errors (HTTP 400).
                        SERVER_ERROR is used for internal server errors (HTTP 500).
                    </xs:documentation>
                </xs:annotation>
                <xs:complexType>
                    <xs:sequence>
                        <xs:element
                            name="faultCode"
                            type="tns:FaultCodeType"/>
                        <xs:element name="message" type="xs:string"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>

        </xs:schema>
    </wsdl:types>

    <wsdl:message name="GetPatientsInput">
        <wsdl:part name="parameters" element="tns:getPatientsRequest"/>
    </wsdl:message>

    <wsdl:message name="GetPatientsOutput">
        <wsdl:part name="parameters" element="tns:getPatientsResponse"/>
    </wsdl:message>

    <wsdl:message name="RegisterPatientInput">
        <wsdl:part name="parameters" element="tns:registerPatientRequest"/>
    </wsdl:message>

    <wsdl:message name="RegisterPatientOutput">
        <wsdl:part name="parameters" element="tns:registerPatientResponse"/>
    </wsdl:message>

    <wsdl:message name="ServiceFaultMessage">
        <wsdl:part name="fault" element="tns:serviceFault"/>
    </wsdl:message>

    <wsdl:portType name="PatientServicePortType">
        <wsdl:operation name="getPatients">
            <wsdl:input message="tns:GetPatientsInput"/>
            <wsdl:output message="tns:GetPatientsOutput"/>
            <wsdl:fault
                name="ServiceFault"
                message="tns:ServiceFaultMessage"/>
        </wsdl:operation>

        <wsdl:operation name="registerPatient">
            <wsdl:input message="tns:RegisterPatientInput"/>
            <wsdl:output message="tns:RegisterPatientOutput"/>
            <wsdl:fault
                name="ServiceFault"
                message="tns:ServiceFaultMessage"/>
        </wsdl:operation>
    </wsdl:portType>

    <wsdl:binding
        name="PatientServiceSoapBinding"
        type="tns:PatientServicePortType">

        <soap:binding
            style="document"
            transport="http://schemas.xmlsoap.org/soap/http"/>

        <wsdl:operation name="getPatients">
            <soap:operation
                soapAction="http://example.com/vet/patients/getPatients"/>
            <wsdl:input>
                <soap:body use="literal"/>
            </wsdl:input>
            <wsdl:output>
                <soap:body use="literal"/>
            </wsdl:output>
            <wsdl:fault name="ServiceFault">
                <soap:fault name="ServiceFault" use="literal"/>
            </wsdl:fault>
        </wsdl:operation>

        <wsdl:operation name="registerPatient">
            <soap:operation
                soapAction="http://example.com/vet/patients/registerPatient"/>
            <wsdl:input>
                <soap:body use="literal"/>
            </wsdl:input>
            <wsdl:output>
                <soap:body use="literal"/>
            </wsdl:output>
            <wsdl:fault name="ServiceFault">
                <soap:fault name="ServiceFault" use="literal"/>
            </wsdl:fault>
        </wsdl:operation>

    </wsdl:binding>

    <wsdl:service name="PatientService">
        <wsdl:port
            name="PatientServiceSoapPort"
            binding="tns:PatientServiceSoapBinding">
            <soap:address
                location="https://example.com/vet/PatientService"/>
        </wsdl:port>
    </wsdl:service>

</wsdl:definitions>
